{
  "version": 1,
  "active_sheet": 0,
  "sheets": [
    {
      "name": "FetchTests",
      "col_widths": {"0": 28, "1": 48, "2": 30, "3": 26},
      "row_heights": {},
      "hidden_rows": [],
      "hidden_cols": [],
      "row_groups": [],
      "col_groups": [],
      "freeze_rows": 2,
      "freeze_cols": 0,
      "cells": [
        {"row": 0, "col": 0, "value": "PYSHEET — FETCH FUNCTION TEST SHEET",
          "fmt": {"bold": true, "align": "left", "fg_color": "#61afef"}},
        {"row": 0, "col": 1, "value": "Open with: pysheet test_fetch.pysheet",
          "fmt": {"italic": true, "align": "left", "fg_color": "#98c379"}},

        {"row": 1, "col": 0, "value": "Description",
          "fmt": {"bold": true, "align": "left", "bg_color": "#2c313a"}},
        {"row": 1, "col": 1, "value": "Formula in cell C",
          "fmt": {"bold": true, "align": "left", "bg_color": "#2c313a"}},
        {"row": 1, "col": 2, "value": "Live Result",
          "fmt": {"bold": true, "align": "left", "bg_color": "#2c313a"}},
        {"row": 1, "col": 3, "value": "Expected",
          "fmt": {"bold": true, "align": "left", "bg_color": "#2c313a"}},

        {"row": 2, "col": 0, "value": "── SCALAR FETCH ──────────────────",
          "fmt": {"bold": true, "align": "left", "fg_color": "#e5c07b"}},

        {"row": 3, "col": 0, "value": "One-shot — JSON field",
          "fmt": {"align": "left"}},
        {"row": 3, "col": 1, "value": "=@FETCH(\"https://httpbin.org/uuid\",0,\"uuid\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 3, "col": 2, "formula": "=@FETCH(\"https://httpbin.org/uuid\",0,\"uuid\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 3, "col": 3, "value": "A UUID string (one-time)",
          "fmt": {"align": "left", "fg_color": "#98c379"}},

        {"row": 4, "col": 0, "value": "Auto-refresh every 8s — UUID",
          "fmt": {"align": "left"}},
        {"row": 4, "col": 1, "value": "=@FETCH(\"https://httpbin.org/uuid\",8,\"uuid\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 4, "col": 2, "formula": "=@FETCH(\"https://httpbin.org/uuid\",8,\"uuid\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 4, "col": 3, "value": "New UUID every 8 seconds",
          "fmt": {"align": "left", "fg_color": "#98c379"}},

        {"row": 5, "col": 0, "value": "Nested JSON path",
          "fmt": {"align": "left"}},
        {"row": 5, "col": 1, "value": "=@FETCH(\"https://httpbin.org/json\",0,\"slideshow.author\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 5, "col": 2, "formula": "=@FETCH(\"https://httpbin.org/json\",0,\"slideshow.author\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 5, "col": 3, "value": "\"Yours Truly\"",
          "fmt": {"align": "left", "fg_color": "#98c379"}},

        {"row": 6, "col": 0, "value": "Deep bracket path",
          "fmt": {"align": "left"}},
        {"row": 6, "col": 1, "value": "=@FETCH(\"https://httpbin.org/json\",0,\"slideshow.slides[0].title\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 6, "col": 2, "formula": "=@FETCH(\"https://httpbin.org/json\",0,\"slideshow.slides[0].title\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 6, "col": 3, "value": "\"Wake up to WonderWidgets!\"",
          "fmt": {"align": "left", "fg_color": "#98c379"}},

        {"row": 7, "col": 0, "value": "Plain text response",
          "fmt": {"align": "left"}},
        {"row": 7, "col": 1, "value": "=@FETCH(\"https://httpbin.org/robots.txt\",0,\"\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 7, "col": 2, "formula": "=@FETCH(\"https://httpbin.org/robots.txt\",0,\"\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 7, "col": 3, "value": "robots.txt content as text",
          "fmt": {"align": "left", "fg_color": "#98c379"}},

        {"row": 8, "col": 0, "value": "── ARRAY / SPILL ─────────────────",
          "fmt": {"bold": true, "align": "left", "fg_color": "#e5c07b"}},

        {"row": 9, "col": 0, "value": "Array — spills into rows below",
          "fmt": {"align": "left"}},
        {"row": 9, "col": 1, "value": "=@FETCH(\"https://jsonplaceholder.typicode.com/todos?_limit=5\",0,\"\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 9, "col": 2, "formula": "=@FETCH(\"https://jsonplaceholder.typicode.com/todos?_limit=5\",0,\"\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 9, "col": 3, "value": "[5 items] + 5 spill rows",
          "fmt": {"align": "left", "fg_color": "#98c379"}},

        {"row": 15, "col": 0, "value": "── ERROR HANDLING ────────────────",
          "fmt": {"bold": true, "align": "left", "fg_color": "#e5c07b"}},

        {"row": 16, "col": 0, "value": "HTTP 404",
          "fmt": {"align": "left"}},
        {"row": 16, "col": 1, "value": "=@FETCH(\"https://httpbin.org/status/404\",0,\"\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 16, "col": 2, "formula": "=@FETCH(\"https://httpbin.org/status/404\",0,\"\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 16, "col": 3, "value": "#HTTP:404",
          "fmt": {"align": "left", "fg_color": "#e06c75"}},

        {"row": 17, "col": 0, "value": "HTTP 500",
          "fmt": {"align": "left"}},
        {"row": 17, "col": 1, "value": "=@FETCH(\"https://httpbin.org/status/500\",0,\"\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 17, "col": 2, "formula": "=@FETCH(\"https://httpbin.org/status/500\",0,\"\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 17, "col": 3, "value": "#HTTP:500",
          "fmt": {"align": "left", "fg_color": "#e06c75"}},

        {"row": 18, "col": 0, "value": "Bad URL / unreachable",
          "fmt": {"align": "left"}},
        {"row": 18, "col": 1, "value": "=@FETCH(\"https://this-does-not-exist.invalid\",0,\"\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 18, "col": 2, "formula": "=@FETCH(\"https://this-does-not-exist.invalid\",0,\"\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 18, "col": 3, "value": "#FETCH",
          "fmt": {"align": "left", "fg_color": "#e06c75"}},

        {"row": 19, "col": 0, "value": "Bad json_path",
          "fmt": {"align": "left"}},
        {"row": 19, "col": 1, "value": "=@FETCH(\"https://httpbin.org/uuid\",0,\"no.such.key\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 19, "col": 2, "formula": "=@FETCH(\"https://httpbin.org/uuid\",0,\"no.such.key\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 19, "col": 3, "value": "#REF",
          "fmt": {"align": "left", "fg_color": "#e06c75"}},

        {"row": 20, "col": 0, "value": "── FORMULA USING FETCH RESULT ────",
          "fmt": {"bold": true, "align": "left", "fg_color": "#e5c07b"}},

        {"row": 21, "col": 0, "value": "Todo item title (text)",
          "fmt": {"align": "left"}},
        {"row": 21, "col": 1, "value": "=@FETCH(\"https://jsonplaceholder.typicode.com/todos/1\",0,\"title\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 21, "col": 2, "formula": "=@FETCH(\"https://jsonplaceholder.typicode.com/todos/1\",0,\"title\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 21, "col": 3, "value": "\"delectus aut autem\"",
          "fmt": {"align": "left", "fg_color": "#98c379"}},

        {"row": 22, "col": 0, "value": "Todo completed? (bool as text)",
          "fmt": {"align": "left"}},
        {"row": 22, "col": 1, "value": "=@FETCH(\"https://jsonplaceholder.typicode.com/todos/1\",0,\"completed\")",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 22, "col": 2, "formula": "=@FETCH(\"https://jsonplaceholder.typicode.com/todos/1\",0,\"completed\")", "value": "#LOADING",
          "fmt": {"align": "left"}},
        {"row": 22, "col": 3, "value": "false",
          "fmt": {"align": "left", "fg_color": "#98c379"}},

        {"row": 23, "col": 0, "value": "── COMMANDS TO TRY ───────────────",
          "fmt": {"bold": true, "align": "left", "fg_color": "#e5c07b"}},

        {"row": 24, "col": 0, "value": ":fetchlist",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 24, "col": 1, "value": "Show all active fetches in a modal",
          "fmt": {"align": "left"}},

        {"row": 25, "col": 0, "value": ":fetchnow C4",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 25, "col": 1, "value": "Force re-fetch the 8s UUID cell immediately",
          "fmt": {"align": "left"}},

        {"row": 26, "col": 0, "value": ":fetchstop C4",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 26, "col": 1, "value": "Freeze UUID cell at its last value",
          "fmt": {"align": "left"}},

        {"row": 27, "col": 0, "value": ":fetchstop all",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 27, "col": 1, "value": "Cancel all active fetches",
          "fmt": {"align": "left"}},

        {"row": 28, "col": 0, "value": "Visual-select C3:C7, then :fetchnow",
          "fmt": {"align": "left", "fg_color": "#56b6c2"}},
        {"row": 28, "col": 1, "value": "Re-fetch a range of cells at once",
          "fmt": {"align": "left"}}
      ]
    }
  ]
}
